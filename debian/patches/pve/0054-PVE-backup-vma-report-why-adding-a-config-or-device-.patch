From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Thomas Lamprecht <t.lamprecht@proxmox.com>
Date: Wed, 30 Sep 2026 22:31:45 +0200
Subject: [PATCH] PVE backup: vma: report why adding a config or device failed

The VMA writer records why adding a config or registering a device
stream failed, but 'vma create' and the QMP backup command only
reported that the operation failed, which left users guessing. Include
the writer's error, so the reason shows up in the command output and
the backup task log.

The most likely failure is a config file larger than the 65535 bytes a
header blob can hold, for example a firewall config with many IP set
entries. For that case, the writer only noted a failed allocation so
far. Let it state the size and the maximum instead.

This relies on the writer recording an error for every failure of these
two functions, which holds since the commit "PVE backup: vma writer:
add config: set error when allocation fails".

Signed-off-by: Thomas Lamprecht <t.lamprecht@proxmox.com>
---
 pve-backup.c | 9 ++++++---
 vma-writer.c | 6 ++++++
 vma.c        | 9 ++++++---
 3 files changed, 18 insertions(+), 6 deletions(-)

diff --git a/pve-backup.c b/pve-backup.c
index 9dccdf37fe..d20c8e39d0 100644
--- a/pve-backup.c
+++ b/pve-backup.c
@@ -578,7 +578,9 @@ static int coroutine_fn pvebackup_co_add_config(
 
     if (format == BACKUP_FORMAT_VMA) {
         if (vma_writer_add_config(vmaw, name, cdata, clen) != 0) {
-            error_setg(errp, "unable to add %s config data to vma archive", file);
+            vma_writer_error_propagate(vmaw, errp);
+            error_prepend(errp, "unable to add %s config data to vma archive - ",
+                          file);
             goto err;
         }
     } else if (format == BACKUP_FORMAT_PBS) {
@@ -1554,8 +1556,9 @@ UuidInfo coroutine_fn *qmp_backup(
 
             int dev_id = vma_writer_register_stream(vmaw, di->device_name, di->size);
             if (dev_id <= 0) {
-                error_set(errp, ERROR_CLASS_GENERIC_ERROR,
-                          "register_stream failed");
+                vma_writer_error_propagate(vmaw, errp);
+                error_prepend(errp, "unable to register device '%s' in vma archive - ",
+                              di->device_name);
                 goto err_mutex;
             }
             assert(dev_id < 256);
diff --git a/vma-writer.c b/vma-writer.c
index 6c1498beb1..3e7e4b8948 100644
--- a/vma-writer.c
+++ b/vma-writer.c
@@ -160,6 +160,12 @@ int vma_writer_add_config(VmaWriter *vmaw, const char *name, gpointer data,
         return -1;
     }
 
+    if (len > UINT16_MAX) {
+        vma_writer_set_error(vmaw, "vma_writer_add_config: config data too large"
+                             " (%zu bytes, maximum is %d)", len, UINT16_MAX);
+        return -1;
+    }
+
     uint32_t name_ptr = allocate_header_string(vmaw, basename);
     if (!name_ptr) {
         vma_writer_set_error(vmaw, "vma_writer_add_config: unable to allocate"
diff --git a/vma.c b/vma.c
index 0e990b5e30..ea372ddc09 100644
--- a/vma.c
+++ b/vma.c
@@ -681,9 +681,10 @@ static int create_archive(int argc, char **argv)
         }
 
         if (vma_writer_add_config(vmaw, name, cdata, clen) != 0) {
+            vma_writer_error_propagate(vmaw, &local_err);
             unlink(archivename);
-            g_error("Unable to append config data %s (len = %zd)",
-                    name, clen);
+            g_error("Unable to append config data %s (len = %zd) - %s",
+                    name, clen, error_get_pretty(local_err));
         }
         l = g_list_next(l);
     }
@@ -737,8 +738,10 @@ static int create_archive(int argc, char **argv)
         int64_t size = blk_getlength(target);
         int dev_id = vma_writer_register_stream(vmaw, devname, size);
         if (dev_id <= 0) {
+            vma_writer_error_propagate(vmaw, &errp);
             unlink(archivename);
-            g_error("vma_writer_register_stream '%s' failed", devname);
+            g_error("vma_writer_register_stream '%s' failed - %s", devname,
+                    error_get_pretty(errp));
         }
 
         BackupJob *job = g_new0(BackupJob, 1);
